__pycache__/
*.pyc
.localdata/
.playwright-mcp/
*.part
*.db
*.db-wal
*.db-shm

# Build output -- PyInstaller (build.py) and pynsist (build_pynsist.py, which
# writes build/installer.cfg and build/nsis/). The .ico is generated from
# assets/icon.png at build time, so it is not an asset to keep either.
build/
dist/
*.spec

# The killboard cache now lives beside the application (config.cache_dir), so
# running from sources drops it here. *.db above already covers the file; this
# keeps the folder itself out too.
cache/
